{
  "name": "makefile-convention-guard",
  "displayName": "Makefile Convention Guard",
  "description": "Lint and fix Makefile whitespace conventions in VS Code",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "contributes": {
    "configuration": {
      "title": "Makefile Convention Guard",
      "properties": {
        "makefileConventionGuard.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable or disable all Makefile Convention Guard diagnostics."
        },
        "makefileConventionGuard.diagnostics.warnTrailingWhitespace": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report trailing spaces or tabs at the end of Makefile lines."
        },
        "makefileConventionGuard.diagnostics.warnMultipleBlankLines": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report two or more consecutive blank lines in Makefiles."
        },
        "makefileConventionGuard.diagnostics.requireFinalNewline": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report Makefiles that do not end with a newline."
        },
        "makefileConventionGuard.diagnostics.warnBlankLineBeforeRecipeCommand": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Report blank lines between a Makefile target and its first recipe command."
        },
        "makefileConventionGuard.execution.cwd": {
          "type": "string",
          "enum": ["makefileDirectory", "workspaceRoot"],
          "enumDescriptions": [
            "Run make from the directory containing the selected Makefile.",
            "Run make from the workspace root."
          ],
          "default": "makefileDirectory",
          "description": "Working directory used when executing a target."
        },
        "makefileConventionGuard.discovery.exclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/.git/**", "**/vendor/**"],
          "description": "Glob patterns excluded while discovering Makefiles."
        },
        "makefileConventionGuard.targets.showInternal": {
          "type": "boolean",
          "default": false,
          "description": "Show targets whose names start with '_' or '.'."
        },
        "makefileConventionGuard.targets.showPatternRules": {
          "type": "boolean",
          "default": false,
          "description": "Show pattern rules such as %.o in the target tree."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "makefileConventionGuard",
          "title": "Makefiles",
          "icon": "./assets/makefile.svg"
        }
      ]
    },
    "views": {
      "makefileConventionGuard": [
        {
          "id": "makefileConventionGuard.favorites",
          "name": "Favoritos",
          "contextualTitle": "Targets favoritos"
        },
        {
          "id": "makefileConventionGuard.targets",
          "name": "Makefiles",
          "contextualTitle": "Makefiles"
        }
      ]
    },
    "commands": [
      {
        "command": "makefileConventionGuard.refreshTargets",
        "title": "Refresh Makefiles",
        "icon": "$(refresh)"
      },
      {
        "command": "makefileConventionGuard.addMakefiles",
        "title": "Add Makefiles",
        "icon": "$(new-file)"
      },
      {
        "command": "makefileConventionGuard.reloadMakefile",
        "title": "Recarregar comandos do Makefile",
        "icon": "$(refresh)"
      },
      {
        "command": "makefileConventionGuard.removeMakefile",
        "title": "Remover Makefile da lista",
        "icon": "$(remove)"
      },
      {
        "command": "makefileConventionGuard.runTarget",
        "title": "Run Make Target",
        "icon": "$(play)"
      },
      {
        "command": "makefileConventionGuard.addFavorite",
        "title": "Fixar target",
        "icon": "$(pin)"
      },
      {
        "command": "makefileConventionGuard.removeFavorite",
        "title": "Desafixar target",
        "icon": "$(pinned)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "makefileConventionGuard.refreshTargets",
          "when": "view == makefileConventionGuard.targets",
          "group": "navigation"
        },
        {
          "command": "makefileConventionGuard.addMakefiles",
          "when": "view == makefileConventionGuard.targets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "makefileConventionGuard.reloadMakefile",
          "when": "view == makefileConventionGuard.targets && viewItem == makefile",
          "group": "navigation@1"
        },
        {
          "command": "makefileConventionGuard.removeMakefile",
          "when": "view == makefileConventionGuard.targets && viewItem == makefile",
          "group": "navigation@2"
        },
        {
          "command": "makefileConventionGuard.addFavorite",
          "when": "view == makefileConventionGuard.targets && viewItem == makefileTarget",
          "group": "inline@1"
        },
        {
          "command": "makefileConventionGuard.removeFavorite",
          "when": "(view == makefileConventionGuard.targets || view == makefileConventionGuard.favorites) && viewItem == favoriteMakefileTarget",
          "group": "inline@1"
        },
        {
          "command": "makefileConventionGuard.runTarget",
          "when": "(view == makefileConventionGuard.targets || view == makefileConventionGuard.favorites) && (viewItem == makefileTarget || viewItem == favoriteMakefileTarget)",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "makefileConventionGuard.reloadMakefile",
          "when": "false"
        },
        {
          "command": "makefileConventionGuard.removeMakefile",
          "when": "false"
        },
        {
          "command": "makefileConventionGuard.addFavorite",
          "when": "false"
        },
        {
          "command": "makefileConventionGuard.removeFavorite",
          "when": "false"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:makefile",
    "onView:makefileConventionGuard.favorites",
    "onView:makefileConventionGuard.targets",
    "onCommand:makefileConventionGuard.refreshTargets",
    "onCommand:makefileConventionGuard.addMakefiles",
    "onCommand:makefileConventionGuard.reloadMakefile",
    "onCommand:makefileConventionGuard.removeMakefile",
    "onCommand:makefileConventionGuard.runTarget",
    "onCommand:makefileConventionGuard.addFavorite",
    "onCommand:makefileConventionGuard.removeFavorite"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && mocha dist/tests/unit/**/*.test.js",
    "test:extension": "npm run compile && vscode-test",
    "test:extension:ci": "vscode-test",
    "test:all": "npm run test:unit && npm run test:extension:ci",
    "vscode:prepublish": "npm run compile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allef-oliveira/makefile-convention-guard.git"
  },
  "keywords": [],
  "author": "allef-ramos",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/allef-oliveira/makefile-convention-guard/issues"
  },
  "homepage": "https://github.com/allef-oliveira/makefile-convention-guard#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  }
}
