{
  "name": "makefile-convention-guard",
  "displayName": "Makefile Convention Guard",
  "description": "Format, validate and run Makefile target from VS Code",
  "version": "1.0.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:makefile"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && npm run test:unit",
    "test:unit": "mocha dist/tests/unit/**/*.test.js",
    "test:extension": "npm run compile && vscode-test",
    "test:all": "npm run compile && npm run test:unit && vscode-test",
    "vscode:prepublish": "npm run compile"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allef-oliveira/makefile-convention-guard.git"
  },
  "keywords": [],
  "author": "allef-ramos",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/allef-oliveira/makefile-convention-guard/issues"
  },
  "homepage": "https://github.com/allef-oliveira/makefile-convention-guard#readme",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "typescript": "^6.0.3"
  }
}
